# Second seed lesson - asyncio.gather exception handling
{
  "lore_version": "0.1",
  "id": "lore:python-async/asyncio-gather-silent-exception/0002",
  "semver": "1.0.0",
  "kind": "gotcha",

  "summary": "asyncio.gather() with return_exceptions=False cancels remaining tasks on first exception but swallows their CancelledError, making it appear tasks vanished silently.",
  "symptoms": [
    "Tasks disappear without trace after asyncio.gather raises",
    "CancelledError not logged or raised from gathered tasks",
    "asyncio.gather cancels siblings but only raises the first exception",
    "Background tasks stop running after unrelated task in gather fails"
  ],
  "domain": "python-async",
  "tags": ["asyncio", "gather", "exception-handling", "task-cancellation"],

  "context": {
    "language": "python",
    "runtime": ">=3.10,<3.14",
    "dependencies": {},
    "os": ["linux", "macos", "windows"],
    "preconditions": [
      "Using asyncio.gather() with multiple coroutines",
      "return_exceptions=False (the default)"
    ]
  },

  "problem": "When return_exceptions=False (default), asyncio.gather cancels all remaining tasks when one raises. The cancelled tasks' CancelledError is silently consumed — no log, no callback. If those tasks had side effects in progress (DB writes, file operations), the side effects are silently abandoned mid-operation.",
  "procedure": [
    "If you need all tasks to run independently, use asyncio.gather(*coros, return_exceptions=True) and inspect results for Exception instances after all complete.",
    "If you need to cancel on first failure BUT log what happened to siblings, use asyncio.TaskGroup (Python 3.11+) which raises ExceptionGroup containing all exceptions.",
    "If on Python <3.11, wrap each coroutine in a try/except that logs before re-raising, so cancellation is at least observable."
  ],
  "anti_patterns": [
    "Assuming asyncio.gather will log or report cancellation of sibling tasks — it won't.",
    "Using gather for tasks with critical side effects without wrapping them in try/finally cleanup blocks.",
    "Catching the first exception from gather and assuming other tasks completed normally — they were cancelled."
  ],
  "failed_attempts": [
    {
      "approach": "Adding a done callback to each task before passing to gather",
      "why_it_fails": "gather() accepts coroutines, not tasks. If you pass tasks, gather wraps them again. The callback fires with CancelledError but by then the gather has already propagated the original exception.",
      "time_wasted_estimate_min": 20
    }
  ],

  "verification": {
    "type": "container",
    "image": "python:3.12-slim",
    "setup": [],
    "files": {
      "test_fix.py": "import asyncio\nimport sys\n\nasync def failing_task():\n    raise ValueError('task failed')\n\nasync def slow_task():\n    await asyncio.sleep(10)\n    return 'completed'\n\nasync def main():\n    # FIX: return_exceptions=True lets us inspect all results\n    results = await asyncio.gather(\n        failing_task(),\n        slow_task(),\n        return_exceptions=True\n    )\n    \n    errors = [r for r in results if isinstance(r, Exception)]\n    successes = [r for r in results if not isinstance(r, Exception)]\n    \n    # We can see that task 1 failed and task 2 was cancelled\n    assert len(errors) == 2, f'Expected 2 errors, got {len(errors)}: {errors}'\n    assert isinstance(errors[0], ValueError)\n    assert isinstance(errors[1], asyncio.CancelledError)\n    \n    print('SUCCESS: All exceptions visible and inspectable')\n    sys.exit(0)\n\nasyncio.run(main())\n",
      "test_broken.py": "import asyncio\nimport sys\n\ncancellation_logged = False\n\nasync def failing_task():\n    raise ValueError('task failed')\n\nasync def slow_task():\n    global cancellation_logged\n    try:\n        await asyncio.sleep(10)\n        return 'completed'\n    except asyncio.CancelledError:\n        cancellation_logged = True\n        raise\n\nasync def main():\n    global cancellation_logged\n    # BROKEN: default return_exceptions=False\n    try:\n        results = await asyncio.gather(\n            failing_task(),\n            slow_task(),\n        )\n    except ValueError:\n        pass  # We catch the first error but...\n    \n    # The slow_task was cancelled silently\n    # cancellation_logged may or may not be True depending on timing\n    # Either way, we lost visibility into what happened\n    print('BROKEN: gather silently cancelled sibling tasks', file=sys.stderr)\n    sys.exit(1)\n\nasyncio.run(main())\n"
    },
    "run": "python test_fix.py",
    "broken_run": "python test_broken.py",
    "broken_files": {},
    "asserts": [
      { "type": "exit_code", "equals": 0 },
      { "type": "stdout_contains", "value": "SUCCESS" }
    ],
